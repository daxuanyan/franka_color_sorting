# Copy this file to .env. Do not commit .env.
# Choose exactly one provider: openai or deepseek.
LLM_PROVIDER=deepseek

# OpenAI configuration (used only when LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek configuration (used only when LLM_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
