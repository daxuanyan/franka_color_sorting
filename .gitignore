# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime logs and temporary files
*.log
*.tmp
*.pid
*.sock

# Local simulator captures and generated observations
observations/

# Keep original screen recordings locally. Only commit edited demo clips and
# lightweight previews from media/demos/.
media/raw/

# Datasets are intentionally kept outside Git. Publish them separately if needed.
vla_datasets/

# Model checkpoints and training artifacts
outputs/**
!outputs/hybrid_vla_acceptance.md
checkpoints/
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx

# Raw benchmark runs can contain thousands of images and logs. Keep only the
# small, reproducible top-level Markdown/SVG summaries in Git.
benchmark_results/**
!benchmark_results/*.md
!benchmark_results/*.svg

# Keep only compact LLM evaluation reports.
llm_eval_results/**
!llm_eval_results/*.md

# Generated numeric dumps outside curated report directories
*.npy
*.npz
